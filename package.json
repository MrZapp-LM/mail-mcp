{
  "name": "imap-mcp-server",
  "version": "1.0.0",
  "description": "MCP-Server für IMAP-Postfächer (lesen, suchen, sortieren) mit optionalem SMTP-Versand. Für Docker/TrueNAS.",
  "type": "module",
  "bin": { "imap-mcp-server": "dist/index.js" },
  "files": ["dist"],
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "smoke": "tsx scripts/smoke.ts"
  },
  "engines": { "node": ">=20.3" },
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/express": "^2.0.2",
    "@modelcontextprotocol/node": "^2.1.2",
    "@modelcontextprotocol/server": "^2.4.0",
    "express": "^5.3.0",
    "imapflow": "^2.11.0",
    "mailparser": "^3.14.2",
    "nodemailer": "^10.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.4.0",
    "@types/express": "^5.0.6",
    "@types/mailparser": "^3.9.0",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^8.0.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}

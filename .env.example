# ---- IMAP (Pflicht) ----
IMAP_HOST=imap.example.com
IMAP_PORT=993
IMAP_SECURE=true
IMAP_USER=paul@example.com
IMAP_PASSWORD=app-passwort-hier

# ---- SMTP (optional: weglassen = kein Senden, nur Entwürfe) ----
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_SECURE=true
# SMTP_USER / SMTP_PASSWORD fallen auf die IMAP-Zugangsdaten zurück
MAIL_FROM=Paul <paul@example.com>
# Bei Gmail auf false setzen (Gmail legt gesendete Mails selbst ab)
SAVE_SENT=true

# ---- MCP-Server ----
# Langer Zufallswert, z. B. mit: openssl rand -hex 32
MCP_AUTH_TOKEN=bitte-ersetzen
# Optional: nur lesen (keine Flags, kein Verschieben/Löschen/Senden)
READ_ONLY=false
# Optional: erlaubte Hostnamen im Host-Header (Schutz vor DNS-Rebinding), kommagetrennt
# ALLOWED_HOSTS=truenas.local,192.168.1.10,mail-mcp.example.com
